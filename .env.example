IS_DEV=true-or-false # true or false for development mode

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Base URL (optional, defaults to official endpoint)
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Enable AI refinement for normal mode transcriptions (true/false)
# When false, normal mode will use raw Whisper transcription without LLM refinement
# Agent mode always uses LLM regardless of this setting
VITE_ENABLE_AI_REFINEMENT=true-or-false

# Note: These environment variables are used by the React frontend
# for direct API calls, not by the Electron main process