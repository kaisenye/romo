IS_DEV=true-or-false # true or false for development mode
DEV_SKIP_ONBOARDING=true-or-false # true or false for onboarding

# Supabase Configuration
# Get these values from your Supabase project settings → API
# Used for user authentication and subscription management
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Web Landing Page URL (for authentication flow)
# Desktop app opens this URL when user needs to sign in
WEB_LOGIN_URL=http://localhost:3000/login?source=desktop

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Base URL (optional, defaults to official endpoint)
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Enable AI refinement for normal mode transcriptions (true/false)
# When false, normal mode will use raw Whisper transcription without LLM refinement
# Agent mode always uses LLM regardless of this setting
VITE_ENABLE_AI_REFINEMENT=true-or-false

VITE_ENABLE_SCREEN_CONTEXT=true-or-false

# Note: These environment variables are used by the React frontend
# for direct API calls, not by the Electron main process
